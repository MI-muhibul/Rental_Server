# Server port (Local development only; Vercel handles its own port)
PORT=5000

# MongoDB Atlas connection string (Must allow network access from 0.0.0.0/0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/equipment_rental?retryWrites=true&w=majority

# Deployed client origin(s) for CORS. Can be a single origin or comma-separated list
CLIENT_URL=https://equipment-rental-client.vercel.app,http://localhost:3000

# JWKS endpoint for validating client JWT tokens (Auth0 / Kinde / Clerk / Next.js)
JWKS_URL=https://equipment-rental-client.vercel.app/api/auth/jwks

# Stripe secret key for handling checkout sessions
STRIPE_SECRET_KEY=sk_test_51...

# SMTP Configuration for rental completion notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Equipment Rental" <your_email@gmail.com>

# Environment
NODE_ENV=production
